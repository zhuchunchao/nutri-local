# NutriLocal — Nginx reverse proxy (TLS termination → Node on 8790)
# Do NOT expose plain :8790 to the public Internet.
#
# 1) Place certs (Let's Encrypt / your CA)
# 2) sudo ln -s this file into sites-enabled (or include it)
# 3) nginx -t && systemctl reload nginx
# 4) Node: HOST=0.0.0.0 PORT=8790 NUTRI_API_KEY=... npm start
#    (bind localhost-only behind same host if preferred: HOST=127.0.0.1)

# Edge rate limit (optional; Node also has per-IP limits)
limit_req_zone $binary_remote_addr zone=nutri_api:10m rate=30r/s;

upstream nutri_local {
    server 127.0.0.1:8790;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name nutri.example.com;

    ssl_certificate     /etc/letsencrypt/live/nutri.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nutri.example.com/privkey.pem;

    # Optional: tighten CORS at the edge; Node also sends Allow-Origin *
    # add_header Access-Control-Allow-Origin $http_origin always;

    location / {
        limit_req zone=nutri_api burst=60 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Pass through caller API key (required by NutriLocal)
        proxy_set_header X-Api-Key $http_x_api_key;
        proxy_pass http://nutri_local;
    }
}

server {
    listen 80;
    server_name nutri.example.com;
    return 301 https://$host$request_uri;
}
