# Copy to .env or export in shell / systemd. Do not commit real secrets.
HOST=0.0.0.0
PORT=8790
NUTRI_API_KEY=replace-me-with-a-long-random-secret

# Rate limit (per client IP, fixed window)
NUTRI_RATE_MAX=120
NUTRI_RATE_WINDOW_MS=60000
# NUTRI_RATE_DISABLED=1

# Local-only escape hatch (never enable on a public host):
# NUTRI_AUTH_DISABLED=1

# Optional vision LLM for POST /api/food/image_recognize (OpenAI-compatible).
# Leave VISION_API_KEY empty to stay fully offline (hint / filename + local DB).
# Do not commit a real key.
# VISION_API_KEY=
# VISION_API_BASE=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini
# VISION_TIMEOUT_MS=20000
